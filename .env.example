# ==============================================================================
# UNSENT — Production & Local Development Environment Template
# Architecture: Google Cloud Run (Frankfurt europe-west3)
# Database: Neon PostgreSQL (Frankfurt)
# Rate Limiting: Upstash Redis (Frankfurt)
# Note: Never commit real credentials. Inject secrets via Secret Manager in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT="8080"
CLOUD_RUN_REGION="europe-west3"

# ------------------------------------------------------------------------------
# 2. Neon PostgreSQL Database (Frankfurt eu-central-1 / europe-west3)
# ------------------------------------------------------------------------------
# Pooled Connection String: Used by the runtime Next.js server (PgBouncer pooler on port 6543)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.eu-central-1.aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://placeholder:placeholder@ep-xyz-pooler.eu-central-1.aws.neon.tech/unsent?sslmode=require"

# Direct Connection String: Used exclusively by Prisma Migrate for schema migrations and DDL operations
# Format: postgresql://[user]:[password]@[endpoint].eu-central-1.aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://placeholder:placeholder@ep-xyz.eu-central-1.aws.neon.tech/unsent?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Session Cryptography & Identity Security
# ------------------------------------------------------------------------------
# High-entropy random secret (64+ characters, generate via `openssl rand -hex 32`)
SESSION_SECRET="generate-a-strong-random-64-character-secret-for-production"

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting & Abuse Prevention (Upstash Redis, Frankfurt)
# ------------------------------------------------------------------------------
# REST URL and Token from Upstash Console (choose regional database in Frankfurt / eu-central-1)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ------------------------------------------------------------------------------
# 5. Platform Stewards & Moderation Access
# ------------------------------------------------------------------------------
# Secret token for programmatic steward operations (x-moderator-token header)
MODERATOR_TOKEN="generate-a-strong-moderator-token-32-chars-minimum"

# Comma-separated list of permanent UNSENT IDs granted steward moderation privileges
MODERATOR_UNSENT_IDS="@steward_primary,@ops_lead"
