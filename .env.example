# ==============================================================================
# UNSENT — Environment Template
# Note: Provide real credentials in your local .env file before running database migrations.
# ==============================================================================

# Node & Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database (Supabase, Neon, or local instance)
# e.g., postgresql://USER:PASSWORD@HOST:5432/unsent?schema=public
DATABASE_URL="postgresql://placeholder:placeholder@localhost:5432/unsent?schema=public"

# Session Secret (64+ character random string)
SESSION_SECRET=""

# Rate Limiting & Abuse Prevention (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile (Bot Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Moderation Authorization
# Secret token for programmatic moderator API calls (passed via x-moderator-token or Authorization: Bearer)
MODERATOR_TOKEN=""
# Comma-separated list of unsent IDs granted moderator/admin privileges (e.g. @moderator_1, @admin_ops)
MODERATOR_UNSENT_IDS=""
